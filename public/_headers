# Response headers for Cloudflare's static-asset serving (see wrangler.jsonc).
# This file is read by Cloudflare at deploy time, not served.

# Vite fingerprints every file under /assets/, so they can be cached for good.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
