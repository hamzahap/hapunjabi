{
  "name": "hapunjabi",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "homepage": "https://hamzahap.dev",
  "description": "Hamzah Punjabi — personal site at hamzahap.dev, with the original terminal at /terminal.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "predeploy": "npm run build",
    "deploy": "wrangler deploy",
    "deploy:www": "wrangler deploy --config deploy/www/wrangler.jsonc",
    "deploy:old-url": "gh-pages --dist deploy/github-pages --message \"Moved to hamzahap.dev\""
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "gh-pages": "^6.2.0",
    "vite": "^6.0.7",
    "wrangler": "^4.153.0"
  }
}
